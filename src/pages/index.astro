---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import CategoryGrid from '../components/CategoryGrid.astro';
import Icon from '../components/Icon.astro';
import { counterLocation, industries, site, whatsappLink } from '../data/site';
import catalog from '../data/products.json';
const finderFilters = catalog.categories[0].filters.filter((filter) => filter.key !== 'stock');
const services = [
  { icon: 'target', title: 'The right fit. First.', text: 'Tooling matched to your machine and application.' },
  { icon: 'drawing', title: 'Beyond the standard.', text: 'Special profiles and tools made to your drawing.' },
  { icon: 'box', title: 'A partner close to work.', text: 'Personal support from our Al Quoz tooling counter.' },
] as const;
const steps = [
  { title: 'Tell us what you need.', text: 'Share a tool number, machine model or part drawing. Tell us your material, thickness and quantity.', label: 'Your requirement' },
  { title: 'Let’s get the details right.', text: 'We review the application and machine fit, then check availability and the expected lead time.', label: 'Our review' },
  { title: 'Make your next move.', text: 'Review a written quote with clear pricing. Confirm your order and discuss collection or delivery.', label: 'Your next step' },
];
const faqs = [
  { question: 'How do I find the right tool for my machine?', answer: 'Start with the CNC tool finder below, or send us your machine make, model, station and existing tool number. Include a photo of the tool or holder if you are unsure. We will check compatibility before quoting.' },
  { question: 'Can you help with a custom punch, die or mould component?', answer: 'Yes. Share a DXF, DWG, PDF or a dimensioned photo, along with your material, thickness, machine details and required quantity. We will review the requirement and confirm the scope, price and lead time in a quote.' },
  { question: 'What should I include in a quote request?', answer: 'Include the product or part number, machine make and model, material and thickness, quantity and target date. For a replacement, a photo and key dimensions help us identify the correct tooling.' },
  { question: 'Are all catalog products available immediately?', answer: 'Stock and lead times vary by specification and quantity. The catalog helps you identify your requirement; our team confirms current availability and timing with your written quote.' },
  { question: 'Can I collect my order in Dubai?', answer: 'Contact our Al Quoz counter to confirm collection details and opening hours. If you need delivery, share your location so we can discuss the available options with your quote.' },
];
---
<Base title="Torque Moulds Factory | Precision Tooling, Dubai" description="The right tooling for the work ahead. Explore CNC punches, press brake tools, dies, mould components and bandsaw blades. Personal support from Al Quoz, Dubai.">
  <section class="home-hero" aria-labelledby="home-title">
    <picture class="home-hero-image"><source media="(max-width: 680px)" srcset="/images/cnc-machining-mobile.webp" /><img src="/images/cnc-machining.webp" alt="Precision CNC spindle machining a steel component" width="1536" height="1024" fetchpriority="high" /></picture>
    <div class="hero-gridlines" aria-hidden="true"></div>
    <div class="container home-hero-inner"><div class="home-hero-copy">
      <p class="eyebrow eyebrow--light">Built for the makers. Based in Dubai.</p>
      <h1 id="home-title">PRECISION.<br />WITHOUT<br /><span>COMPROMISE.</span></h1>
      <p class="lede">The right tool changes everything. Precision tooling for the machines you run, the parts you make, and the standards you stand for.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="/products/">Explore our tooling <Icon name="diagonal" size={18} /></a><a class="hero-text-link" href="/request-quote/">Discuss your project <Icon name="arrow" size={18} /></a></div>
      <div class="hero-assurance"><span></span>YOUR TOOLING PARTNER IN AL QUOZ, DUBAI</div>
    </div><div class="hero-spec" aria-hidden="true"><Icon name="target" size={36} /><div><span>THE TORQUE STANDARD</span><strong>Every detail matters.</strong><small>Machine. Material. Application.</small></div></div><a class="hero-scroll" href="#catalog-title"><span>SCROLL TO EXPLORE</span><Icon name="arrow" size={18} /></a></div>
    <div class="hero-bottom-line" aria-hidden="true"><span>01 — PRECISION IN PRACTICE</span><span>DUBAI, UNITED ARAB EMIRATES</span></div>
  </section>
  <section class="service-strip" aria-label="Our approach to tooling"><ul class="container service-grid">{services.map((service) => <li><span class="service-icon"><Icon name={service.icon} size={25} /></span><div><strong>{service.title}</strong><span>{service.text}</span></div></li>)}</ul></section>
  <section class="section home-intro" aria-labelledby="intro-title"><div class="container intro-grid"><div><p class="eyebrow">The Torque approach</p><h2 id="intro-title">Great work begins<br />with the <span class="serif-accent">right partner.</span></h2></div><div class="intro-copy"><p class="intro-lead">Behind every clean cut, precise bend and finished part is a tool chosen for the job.</p><p>At Torque Moulds Factory, we bring together sheet-metal tooling, workshop essentials and custom solutions. From a replacement punch to a special die, we help you move from requirement to the right specification.</p><a class="link-more" href="/about/">Get to know Torque <Icon name="diagonal" size={17} /></a></div></div><div class="container capability-facts"><div><strong>06<span> /</span></strong><span>Specialist tooling families</span></div><div><strong>01<span> /</span></strong><span>Partner for your requirements</span></div><div><strong>TO SPEC<span> /</span></strong><span>Standard & custom tooling</span></div><div><strong>DUBAI<span> /</span></strong><span>Local counter. Personal support.</span></div></div></section>
  <section class="section home-catalog" aria-labelledby="catalog-title"><div class="container"><div class="section-head section-head--row"><div><p class="eyebrow">01 / The tooling collection</p><h2 id="catalog-title">Purpose in every profile.</h2><p>From the first cut to the final form. Explore tools built around your operation.</p></div><a class="btn btn-outline" href="/products/">View the full catalog <Icon name="diagonal" size={17} /></a></div><CategoryGrid /><div class="catalog-footnote"><span>Not sure where to start? Share your machine model or a photo.</span><a href={whatsappLink('Hello Torque, can you help me identify the right tool for my machine?')}>Let’s find your tool <Icon name="arrow" size={17} /></a></div></div></section>
  <section class="custom-feature" aria-labelledby="custom-title"><div class="custom-feature-image"><img src="/images/custom-tooling.webp" alt="A technician checking a custom machined die using calipers" width="1100" height="733" loading="lazy" decoding="async" /><span class="image-label">FROM YOUR DRAWING. TO YOUR APPLICATION.</span></div><div class="custom-feature-copy"><p class="eyebrow eyebrow--light">02 / Beyond off-the-shelf</p><h2 id="custom-title">Your part is unique.<br />Your tooling<br /><span>should be too.</span></h2><p>Some jobs call for more than a standard profile. Bring us your drawing, your sample, or the challenge you’re working through. We’ll help define a tooling solution around it.</p><ul class="custom-feature-points"><li>Special punches & forming tools</li><li>Custom dies & sectional tooling</li><li>Mould bases, guides & ejector components</li></ul><a class="btn btn-primary" href="/custom-tooling/">Discover custom tooling <Icon name="diagonal" size={18} /></a><small>Start with a DXF, DWG, PDF or dimensioned photo.</small></div></section>
  <section class="section home-industries" aria-labelledby="industries-title"><div class="container industries-layout"><div class="industries-intro"><p class="eyebrow">03 / Built around your industry</p><h2 id="industries-title">Different industries.<br />One pursuit.<br /><span>Better work.</span></h2><p>From ductwork to elevator panels, the details change. The need for correctly specified tooling stays the same.</p><a class="link-more" href="/industries/">Explore the applications <Icon name="diagonal" size={18} /></a><div class="industry-detail" aria-hidden="true"><Icon name="target" size={84} /><span>THE RIGHT TOOL.<br />THE RIGHT APPLICATION.</span></div></div><div class="home-industry-list">{industries.map((industry,index) => <a href={'/products/'+industry.category+'/'} class="home-industry"><span class="industry-number">0{index+1}</span><div><h3>{industry.name}</h3><p>{industry.note}</p></div><Icon name="diagonal" size={21} /></a>)}</div></div></section>
  <section class="section home-finder" aria-labelledby="finder-title"><div class="container"><div class="finder"><div class="finder-heading"><div><p class="eyebrow">04 / A more precise starting point</p><h2 id="finder-title">Your machine. Your match.</h2><p>Narrow down CNC punching tools by machine, station, type and shape.</p></div><span class="finder-symbol" aria-hidden="true"><Icon name="target" size={58} /></span></div><form class="finder-form" action="/products/cnc-punching-tools/" method="get">{finderFilters.map((filter) => <div class="finder-field"><label for={'finder-'+filter.key}>{filter.key === 'machine' ? 'Machine brand' : filter.label}</label><select id={'finder-'+filter.key} name={filter.key}><option value="">Select {filter.key === 'machine' ? 'brand' : filter.label.toLowerCase()}</option>{filter.options.map((option) => <option value={option}>{option}</option>)}</select></div>)}<button class="btn btn-primary" type="submit">Find my tools <Icon name="arrow" size={18} /></button></form><p class="finder-note">A starting point, with a human behind it. Our team confirms machine compatibility before quoting.</p></div></div></section>
  <section class="section quote-process" aria-labelledby="process-title"><div class="container"><div class="section-head section-head--row"><div><p class="eyebrow">05 / From requirement to ready</p><h2 id="process-title">Clarity. At every step.</h2></div><p class="process-intro">A straightforward conversation.<br />A considered recommendation.<br />A clear way forward.</p></div><ol class="home-steps">{steps.map((step,index) => <li><div class="step-top"><span>0{index+1}</span><Icon name="arrow" size={23} /></div><p class="step-label">{step.label}</p><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></div></section>
  <section class="section home-faq" aria-labelledby="faq-title"><div class="container faq-layout"><div><p class="eyebrow">06 / A few useful answers</p><h2 id="faq-title">Good questions.<br />Clear answers.</h2><p>Everything starts with understanding your requirements. Here’s what helps.</p><a class="link-more" href="/contact/">Speak with our team <Icon name="diagonal" size={17} /></a></div><div class="faq-list">{faqs.map((faq,index) => <details class="faq-item" name="tooling-faq"><summary><span class="faq-number">0{index+1}</span><span>{faq.question}</span><span class="faq-plus" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}</div></div></section>
  <section class="home-cta" aria-labelledby="cta-title"><div class="container home-cta-inner"><div><p class="eyebrow eyebrow--light">Your next project starts here</p><h2 id="cta-title">LET’S MAKE<br /><span>GREAT WORK.</span></h2><p>A tool to replace. A part to develop. A challenge to solve.<br />Bring it to Torque.</p><div class="hero-actions"><a class="btn btn-primary" href="/request-quote/">Start a conversation <Icon name="diagonal" size={18} /></a><a class="hero-text-link" href={'tel:'+site.landline.number}><Icon name="phone" size={17} />{site.landline.display}</a></div></div><a class="cta-location" href="/contact/"><Icon name="pin" size={25} /><span><strong>Close to your workshop.<br />Ready for your next job.</strong><small>{counterLocation}, UAE<br />Monday–Saturday · 8:00–17:30</small></span><Icon name="diagonal" size={20} /></a></div><span class="cta-watermark" aria-hidden="true">TORQUE</span></section>
</Base>
