---
import catalog from '../data/products.json';
import Icon from './Icon.astro';
---

<div class="card-grid">
  {catalog.categories.map((category, index) => (
    <a class="cat-card" href={'/products/' + category.slug + '/'}>
      <div class="cat-image">
        <img src={'/images/' + category.slug + '.webp'} alt="" width="508" height="508" loading="lazy" decoding="async" />
        <span class="cat-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      </div>
      <div class="cat-content">
        <div>
          <h3>{category.name}</h3>
          <p>{category.blurb}</p>
        </div>
        <span class="cat-arrow"><Icon name="diagonal" size={18} /></span>
      </div>
    </a>
  ))}
</div>
