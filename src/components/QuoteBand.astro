---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  link?: string;
  label?: string;
}

const { title, description, eyebrow = 'Talk to Torque', link = '/request-quote/', label = 'Request a quote' } = Astro.props;
---

<section class="cta-band page-cta">
  <div class="container">
    <div>
      <p class="eyebrow eyebrow--light">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <a class="btn btn-primary" href={link}>{label}<Icon name="diagonal" size={18} /></a>
  </div>
</section>
